        <mxCell id="cascade" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Proof-Only Ordinal Cascade&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;P(Y&amp;gt;k) = product(j=0..k) c[j]&lt;br&gt;P(Y=0), …, P(Y=4)&lt;br&gt;E[Y] = sum(k=0..3) P(Y&amp;gt;k)&lt;br&gt;ŷ = round(E[Y]) (safe default)&lt;br&gt;6-rule comparison: diagnostic audit only&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#111111;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
