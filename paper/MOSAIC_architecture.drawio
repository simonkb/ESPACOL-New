        <mxCell id="dense" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Dense Evidence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;$$c^D_{n,k}=\sum_r\alpha_{k,r}P(C_{n,k}\ge r)$$&lt;br&gt;N × 4&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#99CCFF;strokeColor=#111111;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="275" width="145" height="112" as="geometry" />
        </mxCell>
        <mxCell id="e81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#111111;strokeWidth=2;dashed=0;" edge="1" parent="1" source="witness" target="counter">
