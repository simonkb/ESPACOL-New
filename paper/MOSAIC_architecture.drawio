        <mxCell id="alpha" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Learnable Boundary Count Mixtures&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;αₖ = softmax(ηₖ) ∈ Δ³¹&lt;br&gt;α: 4 × 32&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#E9A45A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="462" width="250" height="78" as="geometry" />
