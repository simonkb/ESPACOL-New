        <mxCell id="counter" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Exact Truncated Poisson–Binomial Counter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Zᵢ,ₖ ~ Bernoulli(λᵢ,ₖ)&lt;br&gt;Cₙ,ₖ = Σᵢ∈V Zᵢ,ₖ&lt;br&gt;P(C=0), …, P(C=31), P(C≥32)&lt;br&gt;exact block-tree recurrence • FP32&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#111111;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="265" width="250" height="174" as="geometry" />
