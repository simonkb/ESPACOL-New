        <!-- Panel C -->
        <mxCell id="panel_c" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCF7;strokeColor=#F0B06A;strokeWidth=2;arcSize=8;" vertex="1" parent="1"><mxGeometry x="25" y="980" width="2350" height="274" as="geometry"/></mxCell>
        <mxCell id="panel_c_title" value="&lt;b&gt;(c) Same-circuit explanation and training&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#7A3E00;" vertex="1" parent="1"><mxGeometry x="50" y="993" width="610" height="28" as="geometry"/></mxCell>
        <mxCell id="select_set" value="&lt;b&gt;Select evidence set A&lt;/b&gt;&lt;br&gt;scale + lattice coordinate + boundary&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;from the stored local ledgers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DD;strokeColor=#FF8A00;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#7A3E00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="65" y="1055" width="285" height="104" as="geometry"/></mxCell>
        <mxCell id="subtract" value="&lt;b&gt;Exact ledger deletion&lt;/b&gt;&lt;br&gt;λ&lt;sub&gt;k&lt;/sub&gt;&lt;sup&gt;(-A)&lt;/sup&gt; = λ&lt;sub&gt;k&lt;/sub&gt; - Σ&lt;sub&gt;(s,i)∈A&lt;/sub&gt; r&lt;sub&gt;s,i,k&lt;/sub&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;no re-encoding • no renormalization&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DD;strokeColor=#FF8A00;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#7A3E00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="395" y="1055" width="330" height="104" as="geometry"/></mxCell>
        <mxCell id="replay" value="&lt;b&gt;Replay the identical pure-birth generator&lt;/b&gt;&lt;br&gt;p&lt;sup&gt;(-A)&lt;/sup&gt; = e₀ᵀ exp(Q(λ&lt;sup&gt;(-A)&lt;/sup&gt;))&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;same parameters and numerical path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#614B00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="770" y="1055" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="certificate" value="&lt;b&gt;Exact internal intervention certificate&lt;/b&gt;&lt;br&gt;ΔP(Y&gt;k) • ΔE[Y] • Δposterior&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;set-deletion curves + RF / stride / checksum&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#315B22;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1195" y="1055" width="350" height="104" as="geometry"/></mxCell>
        <mxCell id="scope_note" value="&lt;b&gt;Interpretation scope&lt;/b&gt;&lt;br&gt;Exact for the model's stored rate circuit.&lt;br&gt;Not a claim of pixel causality or lesion identity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#475569;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1585" y="1055" width="300" height="104" as="geometry"/></mxCell>
        <mxCell id="loss" value="&lt;b&gt;Proper ordinal training objective&lt;/b&gt;&lt;br&gt;&lt;br&gt;L = -log p&lt;sub&gt;y&lt;/sub&gt; + 0.25 RPS&lt;br&gt;RPS = ¼ Σ&lt;sub&gt;k=0&lt;/sub&gt;&lt;sup&gt;3&lt;/sup&gt; (c&lt;sub&gt;k&lt;/sub&gt; - 1[y&gt;k])²&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#7A3E3E&quot;&gt;unweighted likelihood; budget loss off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#7A2D2B;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1930" y="1028" width="390" height="172" as="geometry"/></mxCell>
        <mxCell id="ledger_to_select" value="stored evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;strokeColor=#FF8A00;strokeWidth=2.2;fontFamily=Helvetica;fontSize=10;fontColor=#A94E00;labelBackgroundColor=#FFFCF7;" edge="1" parent="1" source="ledger_group" target="select_set"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="943"/><mxPoint x="207" y="943"/><mxPoint x="207" y="1038"/></Array></mxGeometry></mxCell>
        <mxCell id="select_subtract" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#FF8A00;strokeWidth=2.2;" edge="1" parent="1" source="select_set" target="subtract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="subtract_replay" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#FF8A00;strokeWidth=2.2;" edge="1" parent="1" source="subtract" target="replay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="replay_certificate" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#FF8A00;strokeWidth=2.2;" edge="1" parent="1" source="replay" target="certificate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="prediction_loss" value="training only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontColor=#8E3432;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="prediction" target="loss"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2247" y="936"/><mxPoint x="2247" y="1013"/></Array></mxGeometry></mxCell>

        <!-- Structural guarantee footer -->
        <mxCell id="guarantee" value="&lt;b&gt;Structural guarantees:&lt;/b&gt; one prediction path • nonnegative local evidence • cumulative ordinal prerequisites • maximum evidence RF 344 px • deep cross-window mixing prohibited • exact stored-ledger deletion and replay • no global classifier bypass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=1.8;fontFamily=Helvetica;fontSize=13;fontColor=#315B22;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="1271" width="2330" height="45" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;font color=&quot;#173A68&quot;&gt;━━ sole prediction path&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#2A9D8F&quot;&gt;┄ immutable geometry&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#FF8A00&quot;&gt;━━ intervention / replay&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#B85450&quot;&gt;┄ training only&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#667085;" vertex="1" parent="1"><mxGeometry x="640" y="1320" width="1120" height="24" as="geometry"/></mxCell>
