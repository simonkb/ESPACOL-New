        <mxCell id="compiler_ledger" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#173A68;strokeWidth=2;" edge="1" parent="1" source="compiler" target="ledger_group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ledger_sum" value="conserve every term" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#173A68;strokeWidth=2.3;fontFamily=Helvetica;fontSize=10;fontColor=#173A68;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ledger_group" target="conservation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sum_decoder" value="λ₀...λ₃" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#173A68;strokeWidth=2.5;fontFamily=Helvetica;fontSize=11;fontColor=#173A68;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="conservation" target="decoder"><mxGeometry relative="1" as="geometry"/></mxCell>
