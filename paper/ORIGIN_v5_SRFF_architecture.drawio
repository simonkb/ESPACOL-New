        <mxCell id="g23" value="λ₂" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B28A00;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;fontColor=#614B00;labelBackgroundColor=#FFF2CC;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g34" value="λ₃" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B28A00;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;fontColor=#614B00;labelBackgroundColor=#FFF2CC;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="decoder_eq" value="p = e₀ᵀ exp(Q(λ))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;strokeWidth=1.3;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#614B00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1787" y="766" width="255" height="48" as="geometry"/></mxCell>
        <mxCell id="decoder_note" value="upper-bidiagonal generator Q • audited FP64 matrix exponential&lt;br&gt;&lt;b&gt;no classifier bypass&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#667085;" vertex="1" parent="1"><mxGeometry x="1745" y="829" width="340" height="52" as="geometry"/></mxCell>

        <!-- Prediction output -->
        <mxCell id="prediction" value="&lt;b&gt;Ordinal posterior&lt;/b&gt;&lt;br&gt;p(Y=0), ..., p(Y=4)&lt;br&gt;c&lt;sub&gt;k&lt;/sub&gt; = P(Y&gt;k)&lt;br&gt;&lt;br&gt;&lt;b&gt;ŷ = argmax&lt;sub&gt;j&lt;/sub&gt; p&lt;sub&gt;j&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;+ expected grade / median&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2.2;fontFamily=Helvetica;fontSize=14;fontColor=#315B22;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2152" y="626" width="190" height="228" as="geometry"/></mxCell>

