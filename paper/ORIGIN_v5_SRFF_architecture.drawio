        <mxCell id="g0" value="G₀" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#D6B656;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#614B00;" vertex="1" parent="1"><mxGeometry x="1740" y="691" width="44" height="44" as="geometry"/></mxCell>
