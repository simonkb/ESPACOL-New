        <mxCell id="atomnull" value="null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#94A3B8;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#475569;arcSize=8;" vertex="1" parent="1"><mxGeometry x="753" y="778" width="42" height="38" as="geometry"/></mxCell>

        <!-- Cumulative compiler -->
        <mxCell id="compiler" value="&lt;b&gt;Cumulative prerequisite compiler&lt;/b&gt;&lt;br&gt;&lt;br&gt;ρ&lt;sub&gt;s,i,k&lt;/sub&gt; = Σ&lt;sub&gt;m≥k&lt;/sub&gt; a&lt;sub&gt;s,i,m&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;Higher-severity evidence also supports every prerequisite transition.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#D96C00;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#7A3E00;arcSize=8;" vertex="1" parent="1"><mxGeometry x="842" y="616" width="252" height="244" as="geometry"/></mxCell>
        <mxCell id="compiler_chain" value="a₃ ⟶ ρ₃, ρ₂, ρ₁, ρ₀&lt;br&gt;a₂ ⟶ ρ₂, ρ₁, ρ₀&lt;br&gt;a₁ ⟶ ρ₁, ρ₀&lt;br&gt;a₀ ⟶ ρ₀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F3B06A;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#8A4B08;align=left;spacingLeft=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="865" y="748" width="206" height="98" as="geometry"/></mxCell>

        <!-- Local ledgers -->
        <mxCell id="ledger_group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F6;strokeColor=#2A9D8F;strokeWidth=2;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1130" y="574" width="260" height="330" as="geometry"/></mxCell>
        <mxCell id="ledger_title" value="&lt;b&gt;Replayable local rate ledgers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;evidence for G&lt;sub&gt;k&lt;/sub&gt; → G&lt;sub&gt;k+1&lt;/sub&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#16645C;" vertex="1" parent="1"><mxGeometry x="1146" y="586" width="228" height="48" as="geometry"/></mxCell>
        <mxCell id="ledger_eq" value="r&lt;sub&gt;s,i,k&lt;/sub&gt; = V&lt;sub&gt;s,i&lt;/sub&gt; (4096 / M&lt;sub&gt;s&lt;/sub&gt;) π&lt;sub&gt;s,k&lt;/sub&gt; β&lt;sub&gt;k&lt;/sub&gt; ρ&lt;sub&gt;s,i,k&lt;/sub&gt; ≥ 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AC4BA;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#16645C;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1147" y="642" width="226" height="52" as="geometry"/></mxCell>
        <mxCell id="ledger_s4" value="R&lt;sup&gt;(s4)&lt;/sup&gt;: 160 x 160 x 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCEDE8;strokeColor=#2A9D8F;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#16645C;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1160" y="714" width="200" height="42" as="geometry"/></mxCell>
        <mxCell id="ledger_s8" value="R&lt;sup&gt;(s8)&lt;/sup&gt;: 80 x 80 x 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B8E4DD;strokeColor=#2A9D8F;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#16645C;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1160" y="766" width="200" height="42" as="geometry"/></mxCell>
        <mxCell id="ledger_s128" value="R&lt;sup&gt;(s128)&lt;/sup&gt;: 5 x 5 x 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5DBD3;strokeColor=#2A9D8F;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#16645C;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1160" y="818" width="200" height="42" as="geometry"/></mxCell>
        <mxCell id="ledger_note" value="stored with scale, coordinate, stride, RF" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#667085;" vertex="1" parent="1"><mxGeometry x="1148" y="868" width="224" height="24" as="geometry"/></mxCell>

        <!-- Conservation -->
        <mxCell id="conservation" value="&lt;b&gt;Conserved boundary rates&lt;/b&gt;&lt;br&gt;&lt;br&gt;λ&lt;sub&gt;k&lt;/sub&gt; = ν&lt;sub&gt;k&lt;/sub&gt; + Σ&lt;sub&gt;s,i&lt;/sub&gt; r&lt;sub&gt;s,i,k&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;visible learned prior ν&lt;sub&gt;k&lt;/sub&gt;&lt;br&gt;scale simplex + geometry normalization&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAFB;strokeColor=#2570BD;strokeWidth=2.2;fontFamily=Helvetica;fontSize=14;fontColor=#173A68;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1432" y="635" width="240" height="208" as="geometry"/></mxCell>
        <mxCell id="rate_cap" value="Architectural cap: 0 ≤ λ&lt;sub&gt;k&lt;/sub&gt; ≤ 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=1.4;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3F6F2B;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1450" y="858" width="204" height="34" as="geometry"/></mxCell>

        <!-- Pure birth decoder -->
