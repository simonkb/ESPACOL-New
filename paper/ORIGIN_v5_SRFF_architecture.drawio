        <mxCell id="g01" value="λ₀" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B28A00;strokeWidth=1.8;fontFamily=Helvetica;fontSize=11;fontColor=#614B00;labelBackgroundColor=#FFF2CC;" edge="1" parent="1" source="g0" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell>
